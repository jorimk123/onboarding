DATABASE_URL=postgresql://user:password@localhost:5432/crm_onboarding
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
PORT=4000

# Resend — https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=onboarding@yourdomain.com

# DocuSeal — https://docuseal.com
# Self-hosted: https://docuseal.yourdomain.com/api
DOCUSEAL_API_URL=https://api.docuseal.com
DOCUSEAL_API_KEY=your_docuseal_api_key

# Portal URLs (for CORS + email links)
CLIENT_PORTAL_URL=http://localhost:5174
ADMIN_PORTAL_URL=http://localhost:5173

# Checkr — https://dashboard.checkr.com/settings/developer
CHECKR_API_URL=https://api.checkr.com/v1
CHECKR_API_KEY=your_checkr_secret_key

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
